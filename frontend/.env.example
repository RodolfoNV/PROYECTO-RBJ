# ─── Google Identity Services ───────────────────────────────────────────────
# Obtén tu Client ID en: https://console.cloud.google.com/
# 1. Crea un proyecto -> APIs y servicios -> Credenciales -> OAuth 2.0
# 2. En "URIs de redireccionamiento autorizados" agrega: http://localhost:5173
# 3. En "Orígenes de JavaScript autorizados" agrega: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID_AQUI.apps.googleusercontent.com

# ─── API Backend ─────────────────────────────────────────────────────────────
VITE_API_BASE=http://localhost:3001/api
